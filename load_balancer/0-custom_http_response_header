#!/usr/bin/env bash
# Configures Nginx to return the hostname in the X-Served-By HTTP response header

apt-get update -y
apt-get install -y nginx

cat > /etc/nginx/conf.d/0-custom-http-response-header.conf <<'EOF'
add_header X-Served-By $hostname always;
EOF

if nginx -t; then
    service nginx restart
else
    exit 1
fi
